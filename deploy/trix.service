# DRAFT systemd unit for the Trix server. Paths and user are placeholders until the
# Oracle machine is known (see docs/deploy.md). Install: /etc/systemd/system/trix.service
[Unit]
Description=Trix card game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trix
WorkingDirectory=/opt/trix
ExecStart=/usr/bin/node /opt/trix/apps/server/dist/index.js
Environment=PORT=8080
# Only reachable through Caddy on the same machine
Environment=HOST=127.0.0.1
Environment=WEB_DIST=/opt/trix/apps/web/dist
# Rooms survive restarts and deploys
Environment=TRIX_STATE_FILE=/var/lib/trix/rooms.json
Environment=TRIX_LOG_LEVEL=info
StateDirectory=trix
Restart=on-failure
RestartSec=2
# SIGTERM → the server saves rooms and tells browsers to reconnect
KillSignal=SIGTERM
TimeoutStopSec=15

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/trix

[Install]
WantedBy=multi-user.target
