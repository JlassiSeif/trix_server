{
  "name": "tunisian-games-hub",
  "private": true,
  "type": "module",
  "workspaces": [
    "platform/*",
    "games/*/*",
    "brand"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @platform/server\" \"npm run dev -w @platform/web\"",
    "build": "npm run build -w @platform/web && npm run build -w @platform/server",
    "start": "npm run start -w @platform/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "node platform/web/e2e/play-vs-bots.mjs e2e-out",
    "e2e:timed": "node platform/web/e2e/timed-ui.mjs",
    "station": "npm run build && tsx games/trix/station/src/main.ts",
    "arena": "tsx games/trix/station/src/arena.ts",
    "test:accounts": "firebase/emulators.sh \"npx vitest run --root platform/server test/accounts.emulator.test.ts\"",
    "emulators": "firebase/emulators.sh"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "concurrently": "10.0.5",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "version": "0.5.0"
}
