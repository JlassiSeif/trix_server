{
  "name": "trix",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @trix/server\" \"npm run dev -w @trix/web\"",
    "build": "npm run build -w @trix/web && npm run build -w @trix/server",
    "start": "npm run start -w @trix/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "node apps/web/e2e/play-vs-bots.mjs e2e-out",
    "e2e:timed": "node apps/web/e2e/timed-ui.mjs",
    "station": "npm run build && tsx tools/station/src/main.ts",
    "arena": "tsx tools/station/src/arena.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "concurrently": "10.0.5",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "version": "0.5.0"
}
